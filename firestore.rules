// Jam-grade rules: any signed-in (anonymous) client may read/write rooms.
// Good enough for a 2-hour prototype in a room of people standing together.
// NOT suitable for public hosting — see README "Known tradeoffs".
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{code}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
